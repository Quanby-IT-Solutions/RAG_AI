{
  "title": "RAGP Service",
  "uid": "ragp-service",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (route) (rate(rag_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "TTFT p95 (streamed answers)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_chat_ttft_seconds_bucket[5m])))",
          "legendFormat": "ttft p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Token usage (per minute)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(rag_chat_tokens_total[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit-rate",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(rag_cache_lookups_total{result=~\"hits|semanticHits\"}[5m])) / clamp_min(sum(rate(rag_cache_lookups_total[5m])), 1e-9)",
          "legendFormat": "hit-rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Provider 429s / bucket sheds",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(rag_provider_429_total[5m]))",
          "legendFormat": "429 {{provider}}"
        },
        {
          "expr": "sum by (provider) (rate(rag_provider_bucket_events_total{event=\"shed\"}[5m]))",
          "legendFormat": "shed {{provider}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Error rate (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (route) (rate(rag_errors_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
