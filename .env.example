# ==========================================================
# ROOT ENV — consumed by docker-compose variable interpolation
# ==========================================================
# Copy to `.env` before running: docker compose up -d --build
#
# These feed the web image BUILD ARGS (NEXT_PUBLIC_* are inlined into
# the client bundle at build time) and must point at the single Nginx
# origin so the browser talks to the proxy, not the raw ports.
#
# Single-port reverse proxy entrypoint: http://localhost
#   /api/* -> backend,  /* -> web
# ==========================================================

# Reverse proxy toggle.
#   docker-proxy = run the bundled Nginx (default, dev).
#   (empty)      = don't start Nginx; use your own/external proxy. Apps are
#                  reachable at 127.0.0.1:3001 (web) and 127.0.0.1:3000 (backend).
COMPOSE_PROFILES=docker-proxy

NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_API_VERSION=v1

# ----------------------------------------------------------
# In-network Postgres (pgvector) + Redis (compose services)
# ----------------------------------------------------------
# Used by compose to configure the postgres service AND to build the
# DATABASE_URL injected into backend, rag, and the migrate step
# (postgres://<user>:<password>@postgres:5432/<db>).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ragai
# Loopback port the compose postgres is published on for host tooling.
# Bump (e.g. 5433) if a host Postgres already listens on 5432.
POSTGRES_HOST_PORT=5432
# Loopback port the compose redis is published on (default 6379). Uncomment
# and change if 6379 is taken on the host.
# REDIS_HOST_PORT=6379

# ----------------------------------------------------------
# RAG service (Python) — injected into the `rag` compose service
# ----------------------------------------------------------
# Required by rag's fail-fast config; the container aborts naming any
# missing setting.
OPENAI_API_KEY=sk-your-openai-api-key

# Shared HS256 secret for the NestJS -> RAG service JWT (injected into BOTH
# backend and rag so they stay in sync).
RAG_SERVICE_TOKEN_SECRET=dev-rag-service-secret-change-in-production

# Tracing: langsmith (default) | langfuse
TRACING_PROVIDER=langsmith
LANGSMITH_API_KEY=lsv2-your-langsmith-api-key
LANGSMITH_PROJECT=ragp
# Region API host: US (default) | EU https://eu.api.smith.langchain.com |
# APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when TRACING_PROVIDER=langfuse:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
