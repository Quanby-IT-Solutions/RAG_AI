# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development
PORT=3000
# Includes the single-port Nginx proxy origin (http://localhost) plus raw
# ports for non-Docker local dev. In production this is just your one domain.
CORS_ORIGINS=http://localhost,http://localhost:3001,http://localhost:3000

# Database
# Native local dev: localhost (e.g. the compose postgres published on
# 127.0.0.1:5432). Inside Docker (compose) this is OVERRIDDEN to the
# in-network service: postgres://…@postgres:5432/… (see docker-compose.yml).
DATABASE_URL="postgres://postgres:password@localhost:5432/ragai"

# RAG service (Python, internal-only)
# Native local dev: localhost:8000 (pnpm dev starts apps/rag). Inside Docker
# this is OVERRIDDEN to http://rag:8000 (compose service name).
RAG_SERVICE_URL=http://localhost:8000

# RP-4: Prometheus base URL (OB-2 stack) for the cache & performance report
PROMETHEUS_URL=http://localhost:9090
# Shared HS256 secret for the NestJS -> RAG service JWT. Must match the RAG
# service's RAG_SERVICE_TOKEN_SECRET.
RAG_SERVICE_TOKEN_SECRET=dev-rag-service-secret-change-in-production
# Hard timeout (ms) for gateway -> RAG calls (AbortSignal.timeout contract).
RAG_SERVICE_TIMEOUT_MS=60000
# Lifetime (seconds) of the short-lived service JWT minted per request.
RAG_SERVICE_TOKEN_TTL_SECONDS=120

# Authentication (Better Auth)
# Trusted origins must include the public origin the browser uses.
# Behind the proxy that is the single Nginx origin (http://localhost).
BETTER_AUTH_SECRET=default-secret-for-testing-change-in-production
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost,http://localhost:3001,http://localhost:3000
BETTER_AUTH_COOKIE_DOMAIN=localhost

# OAuth Providers (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Rate Limiting (Throttler)
# Two named limiters: "default" (all routes) and "strict" (mutating routes
# decorated with @StrictThrottle()). Storage is in-memory; counters reset on
# restart and are per-instance (multi-instance needs a shared store).
THROTTLE_TTL=60000            # Window in ms for the default limiter
THROTTLE_LIMIT=100            # Max requests per window (default limiter)
THROTTLE_STRICT_TTL=60000     # Window in ms for the strict limiter
THROTTLE_STRICT_LIMIT=10      # Max requests per window (strict limiter)
# Number of trusted proxy hops (1 = single Nginx in front). WARNING: never set
# > 0 if the backend is directly internet-exposed (clients could spoof
# X-Forwarded-For and bypass IP throttling).
TRUST_PROXY=1

# Structured Logging (pino)
LOG_LEVEL=info               # fatal | error | warn | info | debug | trace

# API Docs (Scalar)
# Defaults to true in development, false in production. Set explicitly to
# override. Leave commented out to use the environment-aware default.
# ENABLE_API_DOCS=true

# Transactional Email (SMTP / Mailer)
# Leave SMTP_HOST unset to use the dev console transport (emails printed to
# stdout, no real mail server needed). Set it to use a real SMTP transport.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587                # Standard submission port
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
SMTP_SECURE=false            # true for port 465 (TLS), false for STARTTLS
MAIL_FROM='"Dev Mailer" <no-reply@localhost>'
APP_WEB_URL=http://localhost:3001   # Base URL for email links

# Email Verification
EMAIL_VERIFICATION_ENABLED=true     # Send verification emails on signup
EMAIL_VERIFICATION_REQUIRED=false   # Enforce verification before login (off in dev)

# Auth Rate Limiting (Better Auth built-in)
AUTH_RATE_LIMIT_WINDOW=60     # Window in seconds
AUTH_RATE_LIMIT_MAX=10        # Max auth requests per window

# Self-Registration
# Accounts are admin-provisioned; public sign-up (email/password and social)
# is disabled by default. Set to true only to re-enable self-service sign-up.
# AUTH_SIGN_UP_ENABLED=false
