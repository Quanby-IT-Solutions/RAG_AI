{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": [
			"ts-jest",
			{
				"tsconfig": "<rootDir>/../tsconfig.spec.json"
			}
		]
	},
	"moduleNameMapper": {
		"^@repo/db/(.*)$": "<rootDir>/../../../packages/db/src/$1",
		"^@repo/contracts$": "<rootDir>/../../../packages/contracts/src",
		"^@/(.*)$": "<rootDir>/../src/$1"
	}
}
