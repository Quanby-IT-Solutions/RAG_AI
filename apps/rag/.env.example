# ==========================================================
# RAG SERVICE (Python/FastAPI) ENVIRONMENT VARIABLES
# ==========================================================
# All required settings are validated fail-fast at boot (pydantic-settings):
# a missing/invalid value aborts startup naming the offending setting.
#
# Native local dev: localhost hosts. Inside Docker (compose) these are
# overridden to the in-network service names (postgres/redis).

# --- Infrastructure (required) ---
DATABASE_URL="postgres://postgres:password@localhost:5432/ragai"
# Prefer 127.0.0.1 over localhost: redis-py can resolve localhost to ::1 and
# time out when Redis publishes on IPv4 loopback only.
REDIS_URL="redis://127.0.0.1:6379/0"

# --- Providers / secrets (required) ---
OPENAI_API_KEY=sk-your-openai-api-key
# Shared HS256 secret for the NestJS -> RAG service JWT. Must match the
# backend's RAG_SERVICE_TOKEN_SECRET.
RAG_SERVICE_TOKEN_SECRET=dev-rag-service-secret-change-in-production

# --- Tracing (required for the chosen provider) ---
# langsmith (default) | langfuse
TRACING_PROVIDER=langsmith
LANGSMITH_API_KEY=lsv2-your-langsmith-api-key
LANGSMITH_PROJECT=ragp
# Region API host: US (default) | EU https://eu.api.smith.langchain.com |
# APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when TRACING_PROVIDER=langfuse:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Embedding constants (D1, pinned — do not change) ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Generation (GN-1, optional) ---
# Single-provider chat model (OpenAI), non-streamed. Cheap-fast default.
# GENERATION_MODEL=gpt-4o-mini
# GN-2: hard per-request context token budget (rank-then-select). Read per
# request — an environment change applies without restart.
# CONTEXT_TOKEN_BUDGET=2000

# --- Chunking (IN-4, optional) ---
# semantic (default) | recursive — fixed-size is intentionally not selectable.
# CHUNKING_STRATEGY=semantic
# CHUNK_MIN_CHARS=200
# CHUNK_MAX_CHARS=2000
# Adjacent-sentence distance percentile that declares a semantic boundary.
# SEMANTIC_BREAKPOINT_PERCENTILE=90

# --- Retrieval (RT-1, optional) ---
# Top-k chunks returned per query (per-request override supported).
# RETRIEVAL_TOP_K=5
# pgvector HNSW search breadth, applied per query via SET LOCAL hnsw.ef_search.
# HNSW_EF_SEARCH=40

# --- Hybrid search (RT-2, optional) ---
# RRF fusion weights for the parallel vector/keyword arms (default 50/50).
# RETRIEVAL_VECTOR_WEIGHT=0.5
# RETRIEVAL_KEYWORD_WEIGHT=0.5
# Candidates fetched per arm before fusion (also the RT-3 rerank window).
# RETRIEVAL_CANDIDATE_POOL=20
# Reciprocal Rank Fusion constant: score = weight / (RRF_K + rank).
# RRF_K=60

# --- Hard timeouts (seconds, optional) ---
# DB_TIMEOUT_SECONDS=5
# REDIS_TIMEOUT_SECONDS=5
# EXTERNAL_CALL_TIMEOUT_SECONDS=30
