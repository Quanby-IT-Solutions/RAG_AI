# ==========================================================
# RAG SERVICE (Python/FastAPI) ENVIRONMENT VARIABLES
# ==========================================================
# All required settings are validated fail-fast at boot (pydantic-settings):
# a missing/invalid value aborts startup naming the offending setting.
#
# Native local dev: localhost hosts. Inside Docker (compose) these are
# overridden to the in-network service names (postgres/redis).

# --- Infrastructure (required) ---
DATABASE_URL="postgres://postgres:password@localhost:5432/ragai"
# Prefer 127.0.0.1 over localhost: redis-py can resolve localhost to ::1 and
# time out when Redis publishes on IPv4 loopback only.
REDIS_URL="redis://127.0.0.1:6379/0"

# --- Providers / secrets (required) ---
OPENAI_API_KEY=sk-your-openai-api-key
# Shared HS256 secret for the NestJS -> RAG service JWT. Must match the
# backend's RAG_SERVICE_TOKEN_SECRET.
RAG_SERVICE_TOKEN_SECRET=dev-rag-service-secret-change-in-production

# --- Tracing (required for the chosen provider) ---
# langsmith (default) | langfuse
TRACING_PROVIDER=langsmith
LANGSMITH_API_KEY=lsv2-your-langsmith-api-key
LANGSMITH_PROJECT=ragp
# Region API host: US (default) | EU https://eu.api.smith.langchain.com |
# APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when TRACING_PROVIDER=langfuse:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Embedding constants (D1, pinned — do not change) ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Generation (GN-1, optional) ---
# Single-provider chat model (OpenAI), non-streamed. Cheap-fast default.
# GENERATION_MODEL=gpt-4o-mini
# GN-2: hard per-request context token budget (rank-then-select). Read per
# request — an environment change applies without restart.
# CONTEXT_TOKEN_BUDGET=2000

# --- Chunking (IN-4, optional) ---
# semantic (default) | recursive — fixed-size is intentionally not selectable.
# CHUNKING_STRATEGY=semantic
# CHUNK_MIN_CHARS=200
# CHUNK_MAX_CHARS=2000
# Adjacent-sentence distance percentile that declares a semantic boundary.
# SEMANTIC_BREAKPOINT_PERCENTILE=90

# --- Retrieval (RT-1, optional) ---
# Top-k chunks returned per query (per-request override supported).
# RETRIEVAL_TOP_K=5
# pgvector HNSW search breadth, applied per query via SET LOCAL hnsw.ef_search.
# HNSW_EF_SEARCH=40

# --- Hybrid search (RT-2, optional) ---
# RRF fusion weights for the parallel vector/keyword arms (default 50/50).
# RETRIEVAL_VECTOR_WEIGHT=0.5
# RETRIEVAL_KEYWORD_WEIGHT=0.5
# Candidates fetched per arm before fusion (also the RT-3 rerank window).
# RETRIEVAL_CANDIDATE_POOL=20

# --- Reranking (RT-3) — cross-encoder over the fused candidate window ---
# Off by default (eval A/B needs both states). Provider: cohere (hosted,
# needs COHERE_API_KEY) or local (needs `uv sync --group rerank`).
# RERANK_ENABLED=false
# RERANK_PROVIDER=cohere
# RERANK_WINDOW=20
# RERANK_MODEL=rerank-english-v3.0
# RERANK_TIMEOUT_SECONDS=10
# COHERE_API_KEY=

# --- Multi-query + MMR (RT-5) — independent toggles, both off by default ---
# MULTI_QUERY_ENABLED=false
# MULTI_QUERY_COUNT=3
# MMR_ENABLED=false
# MMR_LAMBDA=0.5

# --- Parent-document retrieval (RT-6) — match small children, return parents ---
# PARENT_DOC_ENABLED=false
# PARENT_GROUP_SIZE=3

# --- Contextual compression (RT-7) — retrieve -> compress -> budget ---
# COMPRESSION_ENABLED=false
# COMPRESSION_PROVIDER=embeddings
# COMPRESSION_SIMILARITY_THRESHOLD=0.25
# COMPRESSION_TIMEOUT_SECONDS=10

# Code-version stamp recorded on eval_runs rows (EV-2); set by CI/deploy.
# GIT_SHA=unknown
# EV-4 gate: max metric drop below baseline before CI blocks deployment.
# EVAL_GATE_TOLERANCE=0.02

# --- Security screening (SC-1, Flow B stage 1) ---
# SECURITY_SCREEN_ENABLED=true
# INJECTION_ACTION=block   # or: neutralize

# --- Per-client rate limiting (SC-2) — Redis-backed, keyed by principal ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_INGEST=10/minute
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_STORAGE=   # override counter store (tests: memory://)

# --- Response/semantic cache (CP-1) — Redis, after SC-1, before retrieval ---
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=3600
# CACHE_SEMANTIC_THRESHOLD=0.95
# CACHE_TTL_JITTER=0.2   # CP-2: uniform expiry jitter fraction

# --- Single-flight coalescing (CP-3, Flow C) ---
# SINGLE_FLIGHT_ENABLED=true
# SINGLE_FLIGHT_LOCK_TTL_SECONDS=90
# SINGLE_FLIGHT_WAIT_TIMEOUT_SECONDS=60
# SINGLE_FLIGHT_POLL_INTERVAL_SECONDS=0.15

# --- Shared provider rate control (CP-4, Flow C) ---
# PROVIDER_BUCKET_ENABLED=true
# PROVIDER_RPM_OPENAI=300
# PROVIDER_RPM_ANTHROPIC=60
# BUCKET_WINDOW_SECONDS=10
# BUCKET_WAIT_TIMEOUT_SECONDS=20
# BUCKET_SHRINK_FACTOR=0.5
# BUCKET_SHRINK_TTL_SECONDS=60

# --- Observability (OB-1) — per-deployment USD/1M price overrides ---
# MODEL_PRICING_JSON={"gpt-4o-mini": [0.15, 0.60]}
# Reciprocal Rank Fusion constant: score = weight / (RRF_K + rank).
# RRF_K=60

# --- Hard timeouts (seconds, optional) ---
# DB_TIMEOUT_SECONDS=5
# REDIS_TIMEOUT_SECONDS=5
# EXTERNAL_CALL_TIMEOUT_SECONDS=30

# --- Model routing (GN-4, optional) ---
# Strong tier defaults to Anthropic. Without ANTHROPIC_API_KEY the router
# serves everything on the cheap-fast model and records why per request.
# ANTHROPIC_API_KEY=sk-ant-your-key
# STRONG_MODEL=claude-opus-4-8
# STRONG_MODEL_PROVIDER=anthropic
# GENERATION_MAX_TOKENS=2048
# ROUTING_QUERY_LENGTH_THRESHOLD=240
# ROUTING_MIN_TOP_SIMILARITY=0.2

# --- Reliability (GN-5, optional) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_SECONDS=0.5
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_COOLDOWN_SECONDS=30
